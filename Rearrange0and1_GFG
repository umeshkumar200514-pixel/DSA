class Solution {
  public:
    void segregate0and1(vector<int> &arr) {
        // Umesh
        int n=arr.size();
        
        
        int left=0;
        int right=n-1;
        
            while(left<=right){
                if(arr[left]==0){
                    left++;
                }
                else if(arr[left]==1){
                    swap(arr[right],arr[left]);
                
                    
                    right--;
                    
                }
                
            
        }
        
    }
};
